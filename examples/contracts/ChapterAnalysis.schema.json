{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$",
          "title": "Project Id",
          "type": "string"
        },
        "work_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$",
          "title": "Work Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "event",
            "speech",
            "thought",
            "interpretation",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "verification": {
          "default": "not_checked",
          "enum": [
            "passed",
            "failed",
            "not_checked"
          ],
          "title": "Verification",
          "type": "string"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        }
      },
      "required": [
        "id",
        "project_id",
        "work_id",
        "kind",
        "statement",
        "source_refs"
      ],
      "title": "Claim",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$",
          "title": "Source Id",
          "type": "string"
        },
        "work_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$",
          "title": "Work Id",
          "type": "string"
        },
        "text_revision": {
          "exclusiveMinimum": 0,
          "title": "Text Revision",
          "type": "integer"
        },
        "chapter": {
          "minLength": 1,
          "title": "Chapter",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "work_id",
        "text_revision",
        "chapter",
        "start_char",
        "end_char",
        "source_sha256"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$",
      "title": "Project Id",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$",
      "title": "Source Id",
      "type": "string"
    },
    "chapter_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$",
      "title": "Chapter Id",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "unresolved_questions": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Questions",
      "type": "array"
    }
  },
  "required": [
    "id",
    "project_id",
    "source_id",
    "chapter_id",
    "summary",
    "claims"
  ],
  "title": "ChapterAnalysis",
  "type": "object"
}
