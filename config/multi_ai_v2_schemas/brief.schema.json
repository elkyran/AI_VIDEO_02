{
  "additionalProperties": false,
  "properties": {
    "topic": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Topic",
      "type": "string"
    },
    "language": {
      "default": "ru",
      "maxLength": 32,
      "minLength": 2,
      "title": "Language",
      "type": "string"
    },
    "target_minutes": {
      "default": 1,
      "maximum": 30,
      "minimum": 1,
      "title": "Target Minutes",
      "type": "integer"
    },
    "style": {
      "default": "serious",
      "maxLength": 500,
      "title": "Style",
      "type": "string"
    },
    "source_profile": {
      "default": "owner_supplied",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$",
      "title": "Source Profile",
      "type": "string"
    },
    "production_mode": {
      "default": "fake",
      "enum": [
        "fake",
        "production"
      ],
      "title": "Production Mode",
      "type": "string"
    },
    "auto_fix_cycles": {
      "default": 1,
      "maximum": 1,
      "minimum": 0,
      "title": "Auto Fix Cycles",
      "type": "integer"
    },
    "output_profile": {
      "default": "ruslan-local-narration",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$",
      "title": "Output Profile",
      "type": "string"
    }
  },
  "required": [
    "topic"
  ],
  "title": "Brief",
  "type": "object"
}
